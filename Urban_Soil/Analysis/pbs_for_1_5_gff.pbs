PBSFILE=/work/microbiome/users/kruthi/intermediate_results/urban_soil/Neighbourhood_Analysis_SQL/run_Create_UrbanSoil_GFF_1_5.pbs

cat > "$PBSFILE" <<'PBS'
#!/bin/bash
#PBS -N US_gff_1_5
#PBS -q cpu_batch_exec
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=19:00:00
#PBS -J 0-20%5
#PBS -o /dev/null
#PBS -e /dev/null

set -eo pipefail

ROOT=/work/microbiome/users/kruthi/intermediate_results/urban_soil/Neighbourhood_Analysis_SQL
SCRIPT="$ROOT/Create_UrbanSoil_GFF.py"
PYTHON=/home/n12228516/.conda/envs/kruthi/bin/python3
WORKERS=${PBS_NCPUS:-4}

SECTION=$(printf '%03d' "$PBS_ARRAY_INDEX")
LOG="$ROOT/logs/gff_1_5_section_${SECTION}.log"

mkdir -p "$ROOT/logs"
exec > "$LOG" 2>&1

echo "Section: $SECTION"
echo "Started: $(date)"
echo "Host: $(hostname)"
echo "Workers: $WORKERS"

"$PYTHON" -s -u "$SCRIPT" \
    --section "$PBS_ARRAY_INDEX" \
    --workers "$WORKERS"

echo "Finished: $(date)"
PBS

bash -n "$PBSFILE" && echo "PBS SCRIPT VALID"
