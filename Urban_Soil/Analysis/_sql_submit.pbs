SQLSCRIPT=/work/microbiome/users/kruthi/intermediate_results/urban_soil/Neighbourhood_Analysis_SQL/UrbanSoil_Overall_Smorfs_analysis_sql.py

cat > "$SQLSCRIPT" <<'PY'
#!/usr/bin/env python3
import gzip
import lzma
import sqlite3
from bisect import bisect_left
from pathlib import Path

SMORF_FILE = Path("/work/microbiome/users/kruthi/GMSC_MAPPER_urbansoil/UrbanSoil_SMORF_resource/UrbanSoil_100AA_SMORFs_origins.tsv.gz")
GENE_CATALOG = Path("/work/microbiome/users/kruthi/intermediate_results/urban_soil/Gene_Catalog_Urban_Soil/UrbanSoil.ORF.orig.tsv.xz")
EGGNOG_DIR = Path("/work/microbiome/users/kruthi/intermediate_results/egg_nog/results")
BASE_OUT = Path("/work/microbiome/users/kruthi/intermediate_results/urban_soil/Neighbourhood_Analysis_SQL")
DB_PATH = BASE_OUT / "urban_soil.db"

BIN_WIDTH = 5
WINDOW = 5
BATCH = 100_000
PROGRESS_EVERY = 25


def inputs():
    missing = [
        str(path)
        for path in (SMORF_FILE, GENE_CATALOG)
        if not path.is_file()
    ]

    files = sorted(
        EGGNOG_DIR.glob("*/*.emapper.annotations.gz")
    )

    if not EGGNOG_DIR.is_dir() or not files:
        missing.append(
            f"eggNOG files under {EGGNOG_DIR}"
        )

    if missing:
        raise FileNotFoundError(
            "Missing input(s):\n" + "\n".join(missing)
        )

    print(
        f"eggNOG annotation files found: {len(files)}",
        flush=True,
    )

    return files


def connect():
    connection = sqlite3.connect(
        str(DB_PATH),
        timeout=120,
    )

    connection.execute("PRAGMA journal_mode=OFF")
    connection.execute("PRAGMA synchronous=OFF")
    connection.execute("PRAGMA temp_store=FILE")
    connection.execute("PRAGMA cache_size=-2097152")

    return connection


def complete():
    if not DB_PATH.is_file():
        return False

    try:
        connection = sqlite3.connect(
            f"file:{DB_PATH}?mode=ro",
            uri=True,
        )

        row = connection.execute(
            "SELECT completed FROM build_status LIMIT 1"
        ).fetchone()

        connection.close()

        return bool(row and row[0])

    except sqlite3.Error:
        return False


def insert_stream(connection, sql, rows, label):
    batch = []
    total = 0

    for row in rows:
        batch.append(row)

        if len(batch) == BATCH:
            connection.executemany(sql, batch)
            connection.commit()

            total += len(batch)
            batch.clear()

            if total % 1_000_000 == 0:
                print(
                    f"  {label}: {total:,} rows",
                    flush=True,
                )

    if batch:
        connection.executemany(sql, batch)
        connection.commit()
        total += len(batch)

    print(
        f"  {label}: {total:,} rows total",
        flush=True,
    )

    return total


def smorf_rows():
    with gzip.open(SMORF_FILE, "rt") as handle:
        next(handle, None)

        for line in handle:
            parts = line.rstrip("\n").split("\t")

            if len(parts) < 4:
                continue

            try:
                start, end = map(
                    int,
                    parts[3].split("-", 1),
                )
            except ValueError:
                continue

            yield (
                parts[0],
                parts[1],
                parts[2].split("_polypolish", 1)[0],
                start,
                end,
            )


def gene_rows():
    with lzma.open(GENE_CATALOG, "rt") as handle:
        header = next(handle).rstrip("\n").split("\t")

        required = (
            "ORF",
            "Sample",
            "Original_ID",
            "Start",
            "End",
            "Strand",
            "Partial",
        )

        positions = {
            name: header.index(name)
            for name in required
        }

        for line in handle:
            parts = line.rstrip("\n").split("\t")

            try:
                original_id = parts[
                    positions["Original_ID"]
                ]

                yield (
                    parts[positions["ORF"]],
                    parts[positions["Sample"]],
                    original_id.split(
                        "_polypolish",
                        1,
                    )[0],
                    original_id,
                    int(parts[positions["Start"]]),
                    int(parts[positions["End"]]),
                    parts[positions["Strand"]],
                    parts[positions["Partial"]],
                )

            except (ValueError, IndexError):
                continue


def eggnog_rows(files, header_box):
    for number, path in enumerate(files, 1):
        sample = path.parent.name

        with gzip.open(path, "rt") as handle:
            for line in handle:
                if line.startswith("#query"):
                    if not header_box:
                        header_box.append(
                            line.rstrip("\n")
                        )
                    continue

                if line.startswith("#") or not line.strip():
                    continue

                yield (
                    sample,
                    line.split("\t", 1)[0],
                    line.rstrip("\n"),
                )

        print(
            f"  eggNOG file {number}/{len(files)}: "
            f"{sample}",
            flush=True,
        )


def build(files):
    print(
        "Initializing corrected SQLite database...",
        flush=True,
    )

    connection = connect()

    connection.executescript(
        """
        CREATE TABLE smorf_occurrences (
            smorf_id TEXT NOT NULL,
            sample TEXT NOT NULL,
            base_contig TEXT NOT NULL,
            smorf_start INTEGER NOT NULL,
            smorf_end INTEGER NOT NULL
        );

        CREATE TABLE genes (
            orf TEXT NOT NULL,
            sample TEXT NOT NULL,
            base_contig TEXT NOT NULL,
            annotation_query TEXT NOT NULL,
            gene_start INTEGER NOT NULL,
            gene_end INTEGER NOT NULL,
            strand TEXT,
            partial TEXT
        );

        CREATE TABLE eggnog (
            sample TEXT NOT NULL,
            query_id TEXT NOT NULL,
            annotation_line TEXT NOT NULL,
            PRIMARY KEY (sample, query_id)
        ) WITHOUT ROWID;

        CREATE TABLE eggnog_metadata (
            annotation_header TEXT NOT NULL
        );

        CREATE TABLE build_status (
            completed INTEGER NOT NULL
        );
        """
    )

    print(
        "Loading smORF occurrences...",
        flush=True,
    )

    insert_stream(
        connection,
        "INSERT INTO smorf_occurrences "
        "VALUES (?, ?, ?, ?, ?)",
        smorf_rows(),
        "smORFs",
    )

    print(
        "Creating smORF summary and index...",
        flush=True,
    )

    connection.execute(
        "CREATE TABLE smorf_summary AS "
        "SELECT smorf_id, COUNT(*) AS occurrence_count "
        "FROM smorf_occurrences "
        "GROUP BY smorf_id"
    )

    connection.execute(
        "CREATE UNIQUE INDEX idx_summary "
        "ON smorf_summary(smorf_id)"
    )

    connection.execute(
        "CREATE INDEX idx_occurrence "
        "ON smorf_occurrences(smorf_id)"
    )

    connection.commit()

    unique_smorfs = connection.execute(
        "SELECT COUNT(*) FROM smorf_summary"
    ).fetchone()[0]

    print(
        f"Unique smORFs: {unique_smorfs:,}",
        flush=True,
    )

    print(
        "Loading genes while retaining Original_ID...",
        flush=True,
    )

    insert_stream(
        connection,
        "INSERT INTO genes "
        "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
        gene_rows(),
        "genes",
    )

    print("Creating gene index...", flush=True)

    connection.execute(
        "CREATE INDEX idx_gene_location "
        "ON genes("
        "sample, base_contig, gene_start, gene_end"
        ")"
    )

    connection.commit()

    print(
        "Loading eggNOG with sample-aware keys...",
        flush=True,
    )

    header = []

    insert_stream(
        connection,
        "INSERT OR REPLACE INTO eggnog "
        "VALUES (?, ?, ?)",
        eggnog_rows(files, header),
        "eggNOG",
    )

    connection.execute(
        "INSERT INTO eggnog_metadata VALUES (?)",
        (
            header[0]
            if header
            else "#query",
        ),
    )

    match = connection.execute(
        """
        SELECT 1
        FROM genes AS g
        JOIN eggnog AS e
          ON e.sample = g.sample
         AND e.query_id = g.annotation_query
        LIMIT 1
        """
    ).fetchone()

    if not match:
        raise RuntimeError(
            "No eggNOG sample + Original_ID match found"
        )

    connection.execute(
        "INSERT INTO build_status VALUES (1)"
    )

    connection.commit()

    print(
        "eggNOG sample + Original_ID validation: PASSED",
        flush=True,
    )

    print(
        "SQLite database ready!",
        flush=True,
    )

    return connection


def get_neighbours(
    connection,
    sample,
    base_contig,
    smorf_start,
    smorf_end,
    smorf_id,
):
    rows = connection.execute(
        """
        SELECT
            orf,
            annotation_query,
            gene_start,
            gene_end,
            strand,
            partial
        FROM genes
        WHERE sample = ?
          AND base_contig = ?
        ORDER BY gene_start
        """,
        (
            sample,
            base_contig,
        ),
    ).fetchall()

    if not rows:
        return None

    genes = [
        {
            "ORF": row[0],
            "Query": row[1],
            "Start": int(row[2]),
            "End": int(row[3]),
            "Strand": row[4],
            "Partial": row[5],
            "Note": "",
        }
        for row in rows
    ]

    overlaps = [
        max(
            0,
            min(gene["End"], smorf_end)
            - max(gene["Start"], smorf_start),
        )
        for gene in genes
    ]

    if max(overlaps) > 0:
        anchor = overlaps.index(max(overlaps))
        note = (
            f"TARGET ({smorf_id}) - overlaps by "
            f"{max(overlaps)} bp"
        )
    else:
        starts = [
            gene["Start"]
            for gene in genes
        ]

        anchor = min(
            bisect_left(starts, smorf_start),
            len(genes) - 1,
        )

        note = (
            f"TARGET ({smorf_id}) - intergenic"
        )

    left = max(0, anchor - WINDOW)
    right = min(
        len(genes),
        anchor + WINDOW + 1,
    )

    result = genes[left:right]
    result[anchor - left]["Note"] = note

    return result


def get_annotations(
    connection,
    sample,
    neighbour_rows,
):
    query_ids = [
        gene["Query"]
        for gene in neighbour_rows
    ]

    placeholders = ",".join(
        "?"
        for _ in query_ids
    )

    rows = connection.execute(
        "SELECT query_id, annotation_line "
        "FROM eggnog "
        "WHERE sample = ? "
        f"AND query_id IN ({placeholders})",
        (
            sample,
            *query_ids,
        ),
    ).fetchall()

    annotation_map = dict(rows)

    missing = sum(
        query_id not in annotation_map
        for query_id in query_ids
    )

    return annotation_map, missing


def process_catalogue(connection):
    annotation_header = connection.execute(
        "SELECT annotation_header "
        "FROM eggnog_metadata LIMIT 1"
    ).fetchone()[0]

    max_count = connection.execute(
        "SELECT MAX(occurrence_count) "
        "FROM smorf_summary"
    ).fetchone()[0]

    bins = [
        (
            start,
            start + BIN_WIDTH - 1,
        )
        for start in range(
            1,
            max_count + 1,
            BIN_WIDTH,
        )
    ]

    bin_counts = {}
    log_path = BASE_OUT / "bin_creation_log.tsv"

    with log_path.open("w") as log:
        log.write(
            "BinStart\tBinEnd\tLabel\t"
            "SmORF_Count\tStatus\tFolder\n"
        )

        for start, end in bins:
            count = connection.execute(
                "SELECT COUNT(*) "
                "FROM smorf_summary "
                "WHERE occurrence_count BETWEEN ? AND ?",
                (
                    start,
                    end,
                ),
            ).fetchone()[0]

            bin_counts[(start, end)] = count
            label = f"{start}_{end}"

            status = (
                "CREATED"
                if count
                else "SKIPPED_EMPTY"
            )

            folder = (
                f"SmORF_neighbourhoods_{label}"
                if count
                else "NA"
            )

            log.write(
                f"{start}\t{end}\t{label}\t"
                f"{count}\t{status}\t{folder}\n"
            )

    print(
        f"Bin log written: {log_path}",
        flush=True,
    )

    for start, end in bins:
        total = bin_counts[(start, end)]

        if not total:
            continue

        label = f"{start}_{end}"

        output_root = (
            BASE_OUT
            / f"SmORF_neighbourhoods_{label}"
        )

        output_root.mkdir(
            parents=True,
            exist_ok=True,
        )

        print(
            f"\nProcessing bin: {label} "
            f"({total} smORFs)",
            flush=True,
        )

        smorf_ids = connection.execute(
            "SELECT smorf_id "
            "FROM smorf_summary "
            "WHERE occurrence_count BETWEEN ? AND ? "
            "ORDER BY smorf_id",
            (
                start,
                end,
            ),
        )

        summary_path = (
            output_root / "summary.tsv"
        )

        with summary_path.open("w") as summary:
            summary.write(
                "SmORF_ID\tTotalOccurrences\t"
                "OccurrencesProcessed\t"
                "NeighborsWritten\t"
                "SkippedNoGenes\t"
                "EggNOGMissing\n"
            )

            for number, (smorf_id,) in enumerate(
                smorf_ids,
                1,
            ):
                occurrences = connection.execute(
                    "SELECT sample, base_contig, "
                    "smorf_start, smorf_end "
                    "FROM smorf_occurrences "
                    "WHERE smorf_id = ?",
                    (
                        smorf_id,
                    ),
                ).fetchall()

                processed = 0
                written = 0
                skipped_no_genes = 0
                eggnog_missing = 0

                for (
                    sample,
                    base_contig,
                    smorf_start,
                    smorf_end,
                ) in occurrences:
                    processed += 1

                    neighbour_rows = get_neighbours(
                        connection,
                        sample,
                        base_contig,
                        smorf_start,
                        smorf_end,
                        smorf_id,
                    )

                    if not neighbour_rows:
                        skipped_no_genes += 1
                        continue

                    output_directory = (
                        output_root
                        / smorf_id
                        / f"{sample}_{base_contig}"
                    )

                    output_directory.mkdir(
                        parents=True,
                        exist_ok=True,
                    )

                    with (
                        output_directory
                        / "neighbors.tsv"
                    ).open("w") as output:
                        output.write(
                            "ORF\tSample\tContig\t"
                            "Start\tEnd\tStrand\t"
                            "Partial\tNote\n"
                        )

                        for gene in neighbour_rows:
                            output.write(
                                f"{gene['ORF']}\t"
                                f"{sample}\t"
                                f"{gene['Query']}\t"
                                f"{gene['Start']}\t"
                                f"{gene['End']}\t"
                                f"{gene['Strand']}\t"
                                f"{gene['Partial']}\t"
                                f"{gene['Note']}\n"
                            )

                    (
                        annotation_map,
                        missing,
                    ) = get_annotations(
                        connection,
                        sample,
                        neighbour_rows,
                    )

                    eggnog_missing += missing

                    with (
                        output_directory
                        / "EggNOG_annotations.tsv"
                    ).open("w") as output:
                        output.write(
                            annotation_header.rstrip("\n")
                            + "\n"
                        )

                        for gene in neighbour_rows:
                            annotation = (
                                annotation_map.get(
                                    gene["Query"]
                                )
                            )

                            if annotation:
                                output.write(
                                    annotation.rstrip("\n")
                                    + "\n"
                                )

                    written += 1

                summary.write(
                    f"{smorf_id}\t"
                    f"{len(occurrences)}\t"
                    f"{processed}\t"
                    f"{written}\t"
                    f"{skipped_no_genes}\t"
                    f"{eggnog_missing}\n"
                )

                if (
                    number % PROGRESS_EVERY == 0
                    or number == total
                ):
                    print(
                        f"  [{label}] "
                        f"{number}/{total} done",
                        flush=True,
                    )

        print(
            f"Completed bin: {label}",
            flush=True,
        )


def main():
    annotation_files = inputs()

    BASE_OUT.mkdir(
        parents=True,
        exist_ok=True,
    )

    (
        BASE_OUT / "logs"
    ).mkdir(
        parents=True,
        exist_ok=True,
    )

    if DB_PATH.exists() and not complete():
        raise RuntimeError(
            f"Incomplete database exists: {DB_PATH}; "
            "move it aside before rerunning"
        )

    if complete():
        print(
            "Complete SQLite database exists; "
            "skipping database construction",
            flush=True,
        )

        connection = connect()
    else:
        connection = build(
            annotation_files
        )

    try:
        process_catalogue(connection)
    finally:
        connection.close()

    print(
        "\nALL DONE",
        flush=True,
    )


if __name__ == "__main__":
    main()
PY
