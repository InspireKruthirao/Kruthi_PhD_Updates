#!/bin/bash -l

#PBS -N US_cluster_table
#PBS -l select=1:ncpus=16:mem=64gb
#PBS -l walltime=48:00:00
#PBS -q cpu_batch_exec
#PBS -j oe
#PBS -m abe

set -euo pipefail


WORKDIR="/work/microbiome/users/kruthi/intermediate_results/urban_soil/Prodigal"

cd "$WORKDIR"


echo "=============================================="
echo "Urban Soil corrected cluster table"
echo "=============================================="
echo "Job ID:     $PBS_JOBID"
echo "Host:       $(hostname)"
echo "Start:      $(date)"
echo "Directory:  $(pwd)"
echo "=============================================="
echo


# Use existing Kruthi environment
export PATH="/home/n12228516/.conda/envs/kruthi/bin:$PATH"


echo "Python:"
which python3
python3 --version


echo
echo "NumPy:"
python3 -c "import numpy; print(numpy.__version__)"


echo
echo "Starting corrected cluster-table construction..."
echo


python3 -u make_US_cluster_table.py \
    2>&1 | tee US_cluster_table_CORRECTED.log


echo
echo "=============================================="
echo "JOB FINISHED SUCCESSFULLY"
echo "End: $(date)"
echo "=============================================="
