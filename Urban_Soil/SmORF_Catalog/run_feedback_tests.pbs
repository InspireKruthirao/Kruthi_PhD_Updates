#!/bin/bash -l
#PBS -N US_feedback_tests
#PBS -q cpu_batch_exec
#PBS -l select=1:ncpus=16:mem=160gb
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /work/microbiome/users/kruthi/intermediate_results/urban_soil/Neighbourhood_Analysis_SQL/sweep_results_244rules/job.log
#PBS -P DFAZCB7230
#
# Supervisor meeting 28 October: the 244 rules (predict_function.py, with exact
# nearest neighbours, letter profiles and the random forest) with --report
# (random forest by confidence, one factor at a time), then the cascade.
#     qsub run_feedback_tests.pbs

set -eo pipefail
PIXI_ENV=/mnt/hpccs01/home/n12228516/Kruthi_PhD_Updates/Urban_Soil/Pixi_Env
NB=/work/microbiome/users/kruthi/intermediate_results/urban_soil/Neighbourhood_Analysis_SQL
DB=$NB/smorf_neighbourhoods.sqlite
RESULTS=$NB/sweep_results_244rules
PY="pixi run --manifest-path $PIXI_ENV/pixi.toml python"

mkdir -p "$RESULTS"
cd "$RESULTS"
$PY "$PIXI_ENV/predict_function.py" "$DB" --save --report 2>&1 | grep -v "^ WARN" | tee sweep.log
$PY "$PIXI_ENV/cascade.py" . 2>&1 | grep -v "^ WARN" | tee cascade.log
