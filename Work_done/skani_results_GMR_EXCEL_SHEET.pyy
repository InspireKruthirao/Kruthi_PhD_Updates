import pandas as pd
import glob
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from openpyxl.utils import get_column_letter

# ── Data preparation ──────────────────────────────────────────────────────────

mimag = pd.read_csv('/work/microbiome/shanghai_dogs/data/ShanghaiDogsTables/SHD_bins_MIMAG_report.csv')
reps = mimag[mimag['Representative'] == 'Yes'].copy()
reps['path'] = '/work/microbiome/shanghai_dogs/data/ShanghaiDogsMAGs/' + reps['Bin ID']
reps['path'].to_csv('/work/microbiome/users/kruthi/MAGs_Onehealth/SHD_Species_Rep_MAGs_list.txt',
                    index=False, header=False)

total_species_reps = sum(1 for _ in open('/work/microbiome/users/kruthi/MAGs_Onehealth/SHD_Species_Rep_MAGs_list.txt'))
total_human = len(glob.glob('/work/microbiome/users/kruthi/MAGs_Onehealth/GMR_REP_6664MAGs/GMR_REP/*.fasta'))

df = pd.read_csv('/work/microbiome/users/kruthi/MAGs_Onehealth/SHD_Species_Rep_vs_Human_ani.tsv', sep='\t')
shared = df[df['ANI'] >= 95].copy()
unique_shanghai = shared['Query_file'].nunique()
unique_human = shared['Ref_file'].nunique()

matched_files = shared['Query_file'].unique()
reps['full_path'] = '/work/microbiome/shanghai_dogs/data/ShanghaiDogsMAGs/' + reps['Bin ID']
dog_specific = reps[~reps['full_path'].isin(matched_files)].copy()

# Extract species and genus from Classification column
dog_specific['species'] = dog_specific['Classification'].str.extract(r's__(.+)$')
dog_specific['genus']   = dog_specific['Classification'].str.extract(r'g__([^;]+)')

named   = dog_specific[dog_specific['species'].notna()].copy()
unnamed = dog_specific[dog_specific['species'].isna()].copy()

# ── Styling helpers ───────────────────────────────────────────────────────────

HEADER_FILL = PatternFill("solid", start_color="1F4E79")
BLUE_FILL   = PatternFill("solid", start_color="2E75B6")
GREEN_FILL  = PatternFill("solid", start_color="70AD47")
HIGH_FILL   = PatternFill("solid", start_color="E2EFDA")
MED_FILL    = PatternFill("solid", start_color="FFF2CC")
ALT_FILL    = PatternFill("solid", start_color="D6E4F0")
WHITE_FILL  = PatternFill("solid", start_color="FFFFFF")

THIN = Side(style="thin", color="B8CCE4")

def thin_border():
    return Border(left=THIN, right=THIN, top=THIN, bottom=THIN)

def style_header(ws, row, cols):
    for col in range(1, cols + 1):
        c = ws.cell(row=row, column=col)
        c.font      = Font(name="Arial", bold=True, color="FFFFFF", size=11)
        c.fill      = HEADER_FILL
        c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
        c.border    = thin_border()
    ws.row_dimensions[row].height = 22

def style_banner(ws, row, cols, text, fill=None, size=13):
    ws.merge_cells(start_row=row, start_column=1, end_row=row, end_column=cols)
    c = ws.cell(row=row, column=1)
    c.value     = text
    c.font      = Font(name="Arial", bold=True, size=size, color="FFFFFF" if fill else "404040")
    c.fill      = fill or WHITE_FILL
    c.alignment = Alignment(horizontal="center", vertical="center", wrap_text=True)
    ws.row_dimensions[row].height = 28 if size >= 13 else 20

def style_row(ws, row, cols, quality=None, alt=False):
    fill = HIGH_FILL if quality == "high-quality" else MED_FILL if quality == "medium-quality" else (ALT_FILL if alt else WHITE_FILL)
    for col in range(1, cols + 1):
        c = ws.cell(row=row, column=col)
        c.font      = Font(name="Arial", size=10)
        c.fill      = fill
        c.alignment = Alignment(horizontal="left", vertical="center", wrap_text=True)
        c.border    = thin_border()

def set_col_widths(ws, widths):
    for i, w in enumerate(widths, 1):
        ws.column_dimensions[get_column_letter(i)].width = w

# ── Workbook 

wb = Workbook()
ws1 = wb.active
ws1.title = "Dog_specific_species"
COLS1 = 5

style_banner(ws1, 1, COLS1,
    f"Dog-Specific Species — No Human Counterpart (ANI < 95%)  |  Total: {len(dog_specific)}  |  Named: {len(named)}  |  Novel unnamed: {len(unnamed)}",
    fill=HEADER_FILL, size=12)

# ── Named species section ──
style_banner(ws1, 2, COLS1, f"Named Species ({len(named)})", fill=BLUE_FILL, size=10)

headers1 = ["No.", "Bin ID", "Species", "Genus", "Quality"]
for col, h in enumerate(headers1, 1):
    ws1.cell(row=3, column=col).value = h
style_header(ws1, 3, COLS1)

for i, (_, row) in enumerate(named.iterrows(), start=1):
    r = 3 + i
    ws1.cell(r, 1).value = i
    ws1.cell(r, 2).value = row['Bin ID']
    ws1.cell(r, 3).value = row['species']
    ws1.cell(r, 4).value = row['genus']
    ws1.cell(r, 5).value = row['Quality']
    style_row(ws1, r, COLS1, quality=row['Quality'])

#  Unnamed species section 
sep = 4 + len(named)
style_banner(ws1, sep, COLS1, f"Novel Unnamed Species ({len(unnamed)}) — Genus-level classification only", fill=GREEN_FILL, size=10)

headers1b = ["No.", "Bin ID", "Species", "Genus", "Quality"]
for col, h in enumerate(headers1b, 1):
    ws1.cell(row=sep + 1, column=col).value = h
style_header(ws1, sep + 1, COLS1)

for i, (_, row) in enumerate(unnamed.iterrows(), start=1):
    r = sep + 1 + i
    ws1.cell(r, 1).value = i
    ws1.cell(r, 2).value = row['Bin ID']
    ws1.cell(r, 3).value = "Novel unnamed species"
    ws1.cell(r, 4).value = row['genus']
    ws1.cell(r, 5).value = row['Quality']
    style_row(ws1, r, COLS1, alt=(i % 2 == 0))

# ── Legend ──
leg = sep + 2 + len(unnamed) + 1
ws1.merge_cells(start_row=leg, start_column=1, end_row=leg, end_column=COLS1)
ws1.cell(leg, 1).value = "Quality legend:"
ws1.cell(leg, 1).font  = Font(name="Arial", bold=True, size=10)
for offset, (label, fill) in enumerate([("High-quality", HIGH_FILL), ("Medium-quality", MED_FILL)], 1):
    rr = leg + offset
    ws1.merge_cells(start_row=rr, start_column=1, end_row=rr, end_column=COLS1)
    c = ws1.cell(rr, 1)
    c.value = f"  {label}"
    c.font  = Font(name="Arial", size=10)
    c.fill  = fill

set_col_widths(ws1, [6, 20, 38, 30, 16])
ws1.freeze_panes = "A4"
out = '/work/microbiome/users/kruthi/MAGs_Onehealth/Dog_specific_species.xlsx'
wb.save(out)
print(f"Saved: {out}")
