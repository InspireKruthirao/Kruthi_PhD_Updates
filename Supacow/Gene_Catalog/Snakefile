# Supacow gene catalogue: the Urban_Soil/Gene_Catalog steps as one Snakemake
# workflow, starting from MAGs. Run from the output directory, e.g.
#   snakemake -s Snakefile --configfile config.yaml --directory <out_dir> --cores 32
# (see run_pipeline.sh). All paths below are relative to out_dir.

import os
from pathlib import Path

S = os.path.join(workflow.basedir, "scripts")
PY = f"{config['env_bin']}/python3"
P = config["prefix"]
T = int(config["threads"])

MAGS = sorted(p.name[:-len(".fasta")] for p in Path(config["mags_dir"]).glob("*.fasta"))
if not MAGS:
    raise ValueError(f"no *.fasta MAGs in {config['mags_dir']}")

os.environ["PATH"] = f"{config['env_bin']}:" + os.environ["PATH"]  # xz for the scripts
EGG_CHUNKS = [f"{i:02d}" for i in range(int(config["eggnog_chunks"]))]
GMSC_CHUNKS = [f"{i:02d}" for i in range(int(config["gmsc_chunks"]))]


rule all:
    input:
        f"{P}.clusters.tsv.xz",
        f"{P}.95NT.emapper.annotations.gz",
        f"smorfs/{P}_90AA_SMORFs.faa.gz",
        f"{P}.catalogue_summary.tsv",


# 00. Prodigal on each MAG (single-genome mode: each MAG is one genome)
rule prodigal:
    input:
        lambda w: f"{config['mags_dir']}/{w.mag}.fasta",
    output:
        fna="prodigal/{mag}/{mag}_orfs.fna",
        faa="prodigal/{mag}/{mag}_proteins.faa",
        gff="prodigal/{mag}/{mag}.gff",
    log:
        "logs/prodigal/{mag}.log",
    threads: 1
    shell:
        "{config[env_bin]}/prodigal -i {input} -p single -d {output.fna} -a {output.faa} "
        "-f gff -o {output.gff} -q > {log} 2>&1"


# 01. all ORFs, with SC.ORF IDs
rule orf_catalog:
    input:
        expand("prodigal/{mag}/{mag}_orfs.fna", mag=MAGS),
        expand("prodigal/{mag}/{mag}_proteins.faa", mag=MAGS),
    output:
        fna=temp(f"work/{P}.ORF.fna"),
        faa=f"{P}.ORF.faa.xz",
        orig=f"{P}.ORF.orig.tsv.xz",
    params:
        n_mags=len(MAGS),
    log:
        "logs/01_orf_catalog.log",
    shell:
        "{PY} {S}/01_build_orf_catalog.py prodigal {params.n_mags} {P} {output.fna} {output.faa} {output.orig} > {log} 2>&1"


rule compress_orf_fna:
    input:
        f"work/{P}.ORF.fna",
    output:
        f"{P}.ORF.fna.xz",
    threads: T
    shell:
        "xz -T{threads} -c {input} > {output}.part && mv {output}.part {output}"


# 02. exact dedup: 100% identity, 100% coverage
rule mmseqs_100nt:
    input:
        f"work/{P}.ORF.fna",
    output:
        rep=temp(f"work/mmseqs100/{P}.mmseqs.100NT_rep_seq.fasta"),
        tsv=temp(f"work/mmseqs100/{P}.mmseqs.100NT_cluster.tsv"),
    params:
        prefix=f"work/mmseqs100/{P}.mmseqs.100NT",
    log:
        "logs/02_mmseqs_100nt.log",
    threads: T
    shell:
        "{config[mmseqs]} easy-linclust {input} {params.prefix} work/mmseqs100/tmp "
        "--min-seq-id 1.0 -c 1.0 --cov-mode 0 --threads {threads} > {log} 2>&1 "
        "&& rm -rf work/mmseqs100/tmp work/mmseqs100/*_all_seqs.fasta"


# 03. 100NT catalogue
rule catalog_100nt:
    input:
        rep=rules.mmseqs_100nt.output.rep,
        tsv=rules.mmseqs_100nt.output.tsv,
        orig=rules.orf_catalog.output.orig,
    output:
        fna=temp(f"work/{P}.100NT.fna"),
        fna_xz=f"{P}.100NT.fna.xz",
        matches=f"{P}.100NT.matches.xz",
    log:
        "logs/03_catalog_100nt.log",
    threads: T
    shell:
        "{PY} {S}/03_catalog_100nt.py {input.rep} {input.tsv} {input.orig} {P} {threads} "
        "{output.fna} {output.fna_xz} {output.matches} > {log} 2>&1"


# 04. 95% identity, 90% coverage, on the 100NT representatives
rule mmseqs_95nt:
    input:
        rules.catalog_100nt.output.fna,
    output:
        rep=temp(f"work/mmseqs95/{P}.mmseqs.95NT_rep_seq.fasta"),
        tsv=temp(f"work/mmseqs95/{P}.mmseqs.95NT_cluster.tsv"),
    params:
        prefix=f"work/mmseqs95/{P}.mmseqs.95NT",
    log:
        "logs/04_mmseqs_95nt.log",
    threads: T
    shell:
        "{config[mmseqs]} easy-cluster {input} {params.prefix} work/mmseqs95/tmp "
        "--min-seq-id 0.95 -c 0.9 --cov-mode 0 --threads {threads} > {log} 2>&1 "
        "&& rm -rf work/mmseqs95/tmp work/mmseqs95/*_all_seqs.fasta"


# 05. 95NT catalogue
rule catalog_95nt:
    input:
        rep=rules.mmseqs_95nt.output.rep,
        tsv=rules.mmseqs_95nt.output.tsv,
        fna100=rules.catalog_100nt.output.fna,
    output:
        fna=f"{P}.95NT.fna.xz",
        matches=f"{P}.95NT.matches.tsv.xz",
    log:
        "logs/05_catalog_95nt.log",
    threads: T
    shell:
        "{PY} {S}/05_catalog_95nt.py {input.rep} {input.tsv} {input.fna100} {P} {threads} "
        "{output.fna} {output.matches} > {log} 2>&1"


# 06. ORF -> 100NT -> 95NT
rule cluster_table:
    input:
        m100=rules.catalog_100nt.output.matches,
        m95=rules.catalog_95nt.output.matches,
        orig=rules.orf_catalog.output.orig,
    output:
        f"{P}.clusters.tsv.xz",
    log:
        "logs/06_cluster_table.log",
    threads: T
    shell:
        "{PY} {S}/06_cluster_table.py {input.m100} {input.m95} {input.orig} {threads} {output} > {log} 2>&1"


# 07a. proteins of the 95NT representatives
rule rep_proteins:
    input:
        fna95=rules.catalog_95nt.output.fna,
        fna100=rules.catalog_100nt.output.fna,
        faa=rules.orf_catalog.output.faa,
    output:
        f"{P}.95NT.faa.xz",
    log:
        "logs/07a_rep_proteins.log",
    shell:
        "{PY} {S}/07_rep_proteins.py {input.fna95} {input.fna100} {input.faa} {output} > {log} 2>&1"


# 07. eggNOG-mapper 2.1.12 (diamond) on the 95NT representatives, once, in
# chunks (finished chunks are kept if the job runs out of time). The database
# is copied to node-local disk once per job (eResearch rule).
rule eggnog_split:
    input:
        rules.rep_proteins.output,
    output:
        temp(expand("work/eggnog/chunk{c}.faa", c=EGG_CHUNKS)),
    params:
        n=len(EGG_CHUNKS),
    log:
        "logs/07_eggnog_split.log",
    shell:
        "{PY} {S}/eggnog_chunks.py split {input} work/eggnog {params.n} > {log} 2>&1"


rule eggnog_chunk:
    input:
        "work/eggnog/chunk{c}.faa",
    output:
        "eggnog/chunk{c}.emapper.annotations",
    log:
        "logs/eggnog/chunk{c}.log",
    threads: 8
    resources:
        mem_mb=40000,
    shell:
        r"""
        set -euo pipefail
        exec > {log} 2>&1
        export PATH="{config[emapper_bin]}:$PATH"   # diamond
        DB=$(bash {S}/local_copy.sh {config[eggnog_db]} cow_eggnog_db)
        TMP="${{TMPDIR:-/tmp}}/cow_eggnog_tmp_{wildcards.c}"
        rm -rf "$TMP"; mkdir -p "$TMP" eggnog
        echo "emapper start: $(date)"
        {config[emapper_bin]}/python {config[emapper_bin]}/emapper.py -m diamond --itype proteins \
            --cpu {threads} --data_dir "$DB" --temp_dir "$TMP" \
            -i {input} --output chunk{wildcards.c} --output_dir eggnog --override
        rm -rf "$TMP"
        echo "emapper end: $(date)"
        """


rule eggnog_merge:
    input:
        expand("eggnog/chunk{c}.emapper.annotations", c=EGG_CHUNKS),
    output:
        f"{P}.95NT.emapper.annotations.gz",
    log:
        "logs/07_eggnog_merge.log",
    shell:
        "{PY} {S}/eggnog_chunks.py merge {output} {input} > {log} 2>&1"


# 09. smORFs: GMSC-mapper 0.2.0 (diamond) on the MAGs, as Urban Soil, in
# chunks of MAGs (contigs renamed <MAG>|<contig>; GMSC-mapper finds genes
# contig by contig, so chunking does not change the result)
rule gmsc_input:
    input:
        expand(f"{config['mags_dir']}/{{mag}}.fasta", mag=MAGS),
    output:
        temp("work/gmsc/chunk{g}.fna"),
    params:
        n=len(GMSC_CHUNKS),
    log:
        "logs/gmsc/input_chunk{g}.log",
    shell:
        "{PY} {S}/gmsc_chunk_input.py {config[mags_dir]} {params.n} {wildcards.g} {output} > {log} 2>&1"


rule gmsc_mapper:
    input:
        "work/gmsc/chunk{g}.fna",
    output:
        mapped="gmsc/chunk{g}/mapped.smorfs.faa",
        predicted="gmsc/chunk{g}/predicted.filtered.smorf.faa",
    params:
        out="gmsc/chunk{g}",
    log:
        "logs/gmsc/chunk{g}.log",
    threads: 8
    resources:
        mem_mb=90000,
    shell:
        r"""
        set -euo pipefail
        exec > {log} 2>&1
        export PATH="{config[gmsc_bin]}:$PATH"
        DB=$(bash {S}/local_copy.sh {config[gmsc_db]} cow_gmsc_db)
        echo "gmsc-mapper start: $(date)"
        {config[gmsc_bin]}/gmsc-mapper -i {input} -o {params.out} --dbdir "$DB" -t {threads} --tool diamond
        # this GMSC-mapper version spells it "filterd"
        [ -f {params.out}/predicted.filterd.smorf.faa ] && mv {params.out}/predicted.filterd.smorf.faa {output.predicted}
        echo "gmsc-mapper end: $(date)"
        """


rule smorf_resource:
    input:
        expand("gmsc/chunk{g}/mapped.smorfs.faa", g=GMSC_CHUNKS),
        expand("gmsc/chunk{g}/predicted.filtered.smorf.faa", g=GMSC_CHUNKS),
    output:
        faa=f"smorfs/{P}_100AA_SMORFs_sequences.faa.gz",
        origins=f"smorfs/{P}_100AA_SMORFs_origins.tsv.gz",
        ht=f"smorfs/{P}_100AA_SMORFs_habitat_taxonomy.tsv",
        log=f"smorfs/{P}_100AA_SMORFs_merge_log.txt",
    params:
        n=len(GMSC_CHUNKS),
    log:
        "logs/09_smorf_resource.log",
    shell:
        "{PY} {S}/09_smorf_resource.py gmsc {params.n} {P}_SM {output.faa} {output.origins} {output.ht} "
        "{output.log} > {log} 2>&1"


# 10. smORFs at 90% identity (CD-HIT, as Urban_Soil/SmORF_Catalog/Cluster_SmORFs.sh)
rule smorf_cdhit:
    input:
        rules.smorf_resource.output.faa,
    output:
        faa=temp(f"work/smorfs/{P}_90AA_SMORFs"),
        clstr=f"smorfs/{P}_90AA_SMORFs.clstr",
    log:
        "logs/10_smorf_cdhit.log",
    threads: 16
    resources:
        mem_mb=20000,
    shell:
        "{config[env_bin]}/cd-hit -i {input} -o {output.faa} -c 0.9 -n 5 -M 16000 -T {threads} -d 0 > {log} 2>&1 "
        "&& mv {output.faa}.clstr {output.clstr}"


rule smorf_90aa:
    input:
        clstr=rules.smorf_cdhit.output.clstr,
        faa=rules.smorf_resource.output.faa,
        origins=rules.smorf_resource.output.origins,
    output:
        clusters=f"smorfs/{P}_SMORF_Clusters.tsv.gz",
        faa=f"smorfs/{P}_90AA_SMORFs.faa.gz",
    log:
        "logs/10_smorf_90aa.log",
    shell:
        "{PY} {S}/10_smorf_90aa.py {input.clstr} {input.faa} {input.origins} {P}_SM {output.clusters} "
        "{output.faa} > {log} 2>&1"


# 08. summary
rule summary:
    input:
        orig=rules.orf_catalog.output.orig,
        clusters=rules.cluster_table.output,
        ann=rules.eggnog_merge.output,
        fna=f"{P}.ORF.fna.xz",
        smorf_log=rules.smorf_resource.output.log,
        smorf_clusters=rules.smorf_90aa.output.clusters,
    output:
        f"{P}.catalogue_summary.tsv",
    log:
        "logs/08_summary.log",
    shell:
        "{PY} {S}/08_summary.py {input.orig} {input.clusters} {input.ann} {output} "
        "{input.smorf_log} {input.smorf_clusters} > {log} 2>&1"
